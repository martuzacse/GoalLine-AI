DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DJANGO_SECRET_KEY=change-me-in-production

# Neon Postgres (paste from Neon dashboard → Connection string → Django or URI)
# Use the "pooled" connection string on Render if Neon offers it (better for many short connections).
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Production (e.g. Render)
# DEBUG=False
# ALLOWED_HOSTS=your-app.onrender.com
# RENDER is set automatically on Render; RENDER_EXTERNAL_HOSTNAME is appended if ALLOWED_HOSTS unset
#
# Debug a generic 500 in production (unset after use):
# SHOW_SERVER_ERRORS=1   # response body becomes a plain-text traceback (do not leave enabled)

# After loading WC fixtures, import squads from JSON (edit matches/data/*.json first):
# python manage.py import_squad_json --file matches/data/wc2026_squads_sample.json

# Render: set DATABASE_URL (Neon). Build command: ./build.sh  (pip + migrate + collectstatic)
# Start command: ./start.sh  (migrate then gunicorn via python -m)
# If you use a raw gunicorn line instead, prefer: python -m gunicorn config.wsgi:application --bind 0.0.0.0:$PORT
#
# Fix "relation matches_match does not exist" (Postgres connected but empty schema):
#   1) Render Shell: python manage.py migrate --noinput
#   2) Or set Start to ./start.sh (migrate every boot) and Build to ./build.sh, then redeploy.
#   DEBUG defaults to False on Render (RENDER is set); set DEBUG=True only for troubleshooting.
#   AUTO_SEED_DEMO=0 disables auto demo seed on empty DB (wsgi.py / start.sh run ensure_initial_data).
#   AUTO_LOAD_WC2026=0 skips loading 72 WC group-stage fixtures; AUTO_LOAD_WC2026_MAX_EXISTING=8 (default)
#   caps auto-replace when you already have more WC rows than that (run load_wc2026_fixtures manually).
#   If static CSS 404s: with DATABASE_URL, WhiteNoise uses WHITENOISE_USE_FINDERS (serves from STATICFILES_DIRS).
#   Opt out of finders: WHITENOISE_STRICT_STATIC_ROOT=1 and ensure collectstatic runs in build/start.
#   WhiteNoise is enabled when DEBUG is False, RENDER is set, or DATABASE_URL is set (covers DEBUG=True on Render).
#   CSRF_TRUSTED_ORIGINS is derived on Render from RENDER_EXTERNAL_HOSTNAME or the first non-local ALLOWED_HOSTS host.
